# Copy this file to .env and fill in your own Supabase project details
# (Project Settings -> API in Supabase). Then run: npm run dev
#
# .env is only for testing on your own computer. Netlify and Vercel don't
# read this file — set the same two names in their project settings instead
# (see HOW TO PUT ONLINE.md).

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
