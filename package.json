{
  "name": "mashaal-rent",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "Monthly rent register for Mashaal Rent a Car",
  "scripts": {
    "build": "tsc && esbuild src/client/app.ts --bundle --minify --target=es2020 --outfile=public/app.js",
    "dev": "esbuild src/client/app.ts --bundle --target=es2020 --outfile=public/app.js --servedir=public --serve=127.0.0.1:8765",
    "check": "tsc"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2"
  }
}
